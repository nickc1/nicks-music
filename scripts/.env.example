# Copy this file to .env and fill in the values from
# https://developer.spotify.com/dashboard (create an app, add
# http://127.0.0.1:8888/callback as a Redirect URI in its settings).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Filled in automatically by spotify_following.py after the first
# successful authorization — leave blank.
SPOTIFY_REFRESH_TOKEN=
